# copy to .env (never commit .env) and pick your own password.
# docker compose reads these for the database container and for the app container.
POSTGRES_USER=lumeo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumeo

PORT=3000

# used by npm run dev / test / migrate on your machine (host port 5433).
# keep the user, password and db name the same as above. if the password has
# special characters, url-encode it here (e.g. @ becomes %40)
DATABASE_URL=postgres://lumeo:change-me@localhost:5433/lumeo

# secret used to sign login tokens (JWT, HS256). at least 32 characters, keep it
# private and never commit it. the app and docker compose refuse to start without
# it. generate one with: openssl rand -base64 48
JWT_SECRET=change-me
# how long a token stays valid (optional, default 1h)
JWT_EXPIRES_IN=1h
